lse" password="false" selected="false" bounds="[68,353][1012,454]" drawing-order="0" hint="" /><node index="1" text="The letter arrived on a grey Tuesday morning in March, when the rain in London had not stopped for three days. Emma Hart found it on the mat by her front door, between a gas bill and an advertisement for a new pizza restaurant. The envelope was thick and cream-coloured, and her name was written on it in careful, old-fashioned handwriting." resource-id="" class="android.widget.TextView" package="com.marat.albion" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[68,528][1012,1286]" drawing-order="1" hint="" /><node index="2" text="She opened it at the kitchen table while her coffee went cold." resource-id="" class="android.widget.TextView" package="com.marat.albion" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[68,1318][1012,1460]" drawing-order="2" hint="" /><node index="3" text="&quot;Dear Miss Hart,&quot; it began. &quot;I am writing on behalf of the late Mr Walter Pengelly of Gull Island, Cornwall. Mr Pengelly passed away last month at the age of eighty-seven. In his will, he left you his cottage and the old lighthouse on the island. I would be grateful if you could contact my office at your earliest " resource-id="" class="android.widget.TextView" package="com.marat.albion" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[68,1492][1012,2096]" drawing-order="3" hint="" /></node></node><node index="2" text="" resource-id="" class="android.view.View" package="com.marat.albion" content-desc="" check