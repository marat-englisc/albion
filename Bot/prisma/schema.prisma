generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             Int      @id @default(autoincrement())
  telegramId     String   @unique
  firstName      String
  timezone       String   @default("Europe/Berlin")
  newCardsPerDay Int      @default(20)
  retention      Float    @default(0.9)
  activeDeck     String   @default("all")
  level          String   @default("all")
  direction      String   @default("recognition")
  autoAudio      Boolean  @default(false)
  createdAt      DateTime @default(now())
  cards          UserCard[]
  reviews        ReviewLog[]
  studySession   StudySession?
  lessons        LessonProgress[]
  attempts       ExerciseAttempt[]
  exerciseSession ExerciseSession?
}

model Deck {
  id       String @id
  title    String
  position Int
  notes    Note[]
}

model Note {
  id           Int     @id @default(autoincrement())
  sourceKey    String  @unique
  deckId       String
  deck         Deck    @relation(fields: [deckId], references: [id])
  term         String
  ipa          String  @default("")
  partOfSpeech String  @default("")
  definition   String  @default("")
  translation  String
  level        String  @default("")
  examples     Json
  forms        Json
  audio        Json
  comment      String  @default("")
  sourceRow    Int
  active       Boolean @default(true)
  cards        UserCard[]
  @@index([deckId, active, level])
}

model UserCard {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId          Int
  note            Note      @relation(fields: [noteId], references: [id])
  direction       String
  due             DateTime  @default(now())
  stability       Float     @default(0)
  difficulty      Float     @default(0)
  elapsedDays     Int       @default(0)
  scheduledDays   Int       @default(0)
  learningSteps   Int       @default(0)
  reps            Int       @default(0)
  lapses          Int       @default(0)
  state           Int       @default(0)
  lastReview      DateTime?
  introducedDay   String?
  suspended       Boolean   @default(false)
  version         Int       @default(0)
  reviews         ReviewLog[]
  sessions        StudySession[]
  @@unique([userId, noteId, direction])
  @@index([userId, direction, suspended, due])
}

model StudySession {
  userId    Int      @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  cardId    Int
  card      UserCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  revealed  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ReviewLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId       Int
  card         UserCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating       Int
  reviewedAt   DateTime
  localDay     String
  previous     Json
  fsrsLog      Json
  versionAfter Int
  undone       Boolean  @default(false)
  @@index([userId, localDay, undone])
}

model Lesson {
  id        Int     @id
  title     String
  level     String
  filename  String  @unique
  markdown  String
  keywords  String
  active    Boolean @default(true)
  progress  LessonProgress[]
  exercises Exercise[]
}

model LessonProgress {
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    Int
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  lastPage    Int      @default(0)
  completedAt DateTime?
  @@id([userId, lessonId])
}

model Exercise {
  id          Int     @id @default(autoincrement())
  sourceKey   String  @unique
  lessonId    Int?
  lesson      Lesson? @relation(fields: [lessonId], references: [id])
  topic       String
  level       String
  kind        String
  prompt      String
  options     Json
  answers     Json
  explanation String
  active      Boolean @default(true)
  attempts    ExerciseAttempt[]
  sessions    ExerciseSession[]
  @@index([lessonId, active])
}

model ExerciseSession {
  userId     Int      @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  exerciseId Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  lessonId   Int?
  createdAt  DateTime @default(now())
}

model ExerciseAttempt {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  answer     String
  correct    Boolean
  createdAt  DateTime @default(now())
  @@index([userId, exerciseId])
}

model AudioCache {
  path      String @id
  signature String
  fileId    String
}
