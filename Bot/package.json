{
  "name": "albion-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "predb:migrate": "node scripts/prepare-database.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "content:import": "tsx src/scripts/import.ts",
    "content:check": "tsx src/scripts/check-content.ts",
    "setup": "npm run db:generate && npm run db:migrate && npm run content:import"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "grammy": "^1.46.0",
    "gray-matter": "^4.0.3",
    "marked": "^16.4.1",
    "pino": "^10.1.0",
    "ts-fsrs": "5.4.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
